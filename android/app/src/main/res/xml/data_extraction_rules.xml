<?xml version="1.0" encoding="utf-8"?>
<!-- Saved homes and private notes are not uploaded to cloud backup by default (privacy register PR-04). -->
<data-extraction-rules>
    <cloud-backup><exclude domain="file" path="." /><exclude domain="sharedpref" path="." /></cloud-backup>
    <device-transfer><include domain="file" path="saved" /></device-transfer>
</data-extraction-rules>
